<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مواقيت الصلاة</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: linear-gradient(#101b3d, #253b70);
      color: white;
      text-align: center;
      min-height: 100vh;
    }

    .container {
      max-width: 700px;
      margin: auto;
      padding: 40px 20px;
    }

    h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .subtitle {
      font-size: 18px;
      opacity: 0.8;
      margin-bottom: 30px;
    }

    .prayers {
      display: grid;
      gap: 15px;
    }

    .prayer {
      background: rgba(255, 255, 255, 0.12);
      padding: 20px;
      border-radius: 18px;
      display: flex;
      justify-content: space-between;
      font-size: 20px;
    }

    .next {
      margin-top: 30px;
      padding: 20px;
      background: rgba(255, 255, 255, 0.18);
      border-radius: 18px;
    }
  </style>
</head>

<body>

  <div class="container">

    <h1>🕌 مواقيت الصلاة</h1>

    <div class="subtitle">
      حافظ على صلاتك ❤️
    </div>

    <div class="prayers">

      <div class="prayer">
        <span>🌙 الفجر</span>
        <span>04:30</span>
      </div>

      <div class="prayer">
        <span>☀️ الظهر</span>
        <span>12:00</span>
      </div>

      <div class="prayer">
        <span>🌤️ العصر</span>
        <span>03:30</span>
      </div>

      <div class="prayer">
        <span>🌅 المغرب</span>
        <span>06:30</span>
      </div>

      <div class="prayer">
        <span>🌙 العشاء</span>
        <span>08:00</span>
      </div>

    </div>

    <div class="next">
      الصلاة القادمة: <strong>المغرب</strong>
      <br><br>
      باقي على الصلاة: <strong>01:25:30</strong>
    </div>

  </div>

</body>



</html>
